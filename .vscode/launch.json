{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "API + Web",
            "configurations": ["API", "Web"],
            "stopAll": true,
            "presentation": {
                "order": 1
            }
        }
    ],
    "configurations": [
        {
            "name": "API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Kiosk.Api/bin/Debug/net10.0/linux-x64/Kiosk.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Kiosk.Api",
            "envFile": "${workspaceFolder}/dbg.env",
            "console": "internalConsole",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5020"
            },
            "presentation": {
                "order": 2
            }
        },
        {
            "name": "Web",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/Kiosk.Web/node_modules/@angular/cli/bin/ng.js",
            "args": ["serve", "--port", "4200"],
            "cwd": "${workspaceFolder}/Kiosk.Web",
            "console": "internalConsole",
            "outputCapture": "std",
            "autoAttachChildProcesses": true,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Compiled successfully\\.",
                "uriFormat": "http://localhost:4200"
            },
            "presentation": {
                "order": 3
            }
        },
        {
            "name": "API Attach",
            "type": "coreclr",
            "request": "attach",
            "presentation": {
                "order": 4
            }
        }
    ]
}